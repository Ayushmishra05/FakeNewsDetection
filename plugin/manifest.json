{
    "manifest_version": 3,
    "name": "Fake News Detection",
    "description": "Check if the news is fake or genuine",
    "version": "1.0",
    "permissions": [
      "activeTab",
      "contextMenus",
      "storage"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
    "host_permissions": [
      "http://127.0.0.1:5000/*"
    ]
  }
  